# ─── Code Compass environment ───────────────────────────────────────────────
# Copy to .env for local development:  cp .env.example .env
# In Vercel, set these under Project → Settings → Environment Variables,
# with DIFFERENT values for Production and Preview/Development.
# Do NOT put NODE_ENV here — Vite would build a development React bundle.

# Postgres connection string. Neon: use the *pooled* connection string (host contains "-pooler").
DATABASE_URL=postgres://postgres@localhost:5432/cc_dev

# 32+ random characters. Generate with:  openssl rand -base64 32
# Changing it signs everyone out.
BETTER_AUTH_SECRET=replace-me-with-openssl-rand-base64-32-output

# Public URL of the app (no trailing slash). Used for auth callbacks and email links.
APP_URL=http://localhost:5173

# Optional: extra origins allowed to call the API with cookies (comma-separated).
TRUSTED_ORIGINS=

# Transactional email (password reset, email confirmation). Configure ONE of:
#  a) Resend (needs a domain you own, verified in Resend):
RESEND_API_KEY=
#  b) SMTP, e.g. a Gmail account + App Password (no domain needed; Gmail allows ~500 emails/day):
#     Google Account -> Security -> 2-Step Verification ON -> App passwords -> create one for "Code Compass".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Sender shown to users. Optional; with Gmail SMTP leave empty (defaults to "Code Compass <SMTP_USER>").
EMAIL_FROM=
# Where locked-out users can ask for help (https:// or mailto:). Optional, shown publicly.
SUPPORT_URL=
# With no provider configured, emails are printed to the API console in development and NOT sent in production.

# "true" blocks sign-in until the email address is confirmed. Only enable once email delivery works.
REQUIRE_EMAIL_VERIFICATION=false

# Request headers that carry the real client IP (set by your host). Vercel's defaults are correct.
IP_HEADERS=x-vercel-forwarded-for,x-real-ip,x-forwarded-for

# Max Postgres connections per serverless instance.
DB_POOL_MAX=5
