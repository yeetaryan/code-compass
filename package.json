{
  "name": "code-compass",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx watch --env-file-if-exists=.env server/dev.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/db-migrate.ts",
    "db:studio": "drizzle-kit studio",
    "legacy:migrate": "tsx --env-file-if-exists=.env scripts/migrate-legacy.ts",
    "legacy:verify": "tsx --env-file-if-exists=.env scripts/verify-migration.ts",
    "test:e2e": "node tests/e2e/flows.mjs",
    "e2e:reset": "bash tests/e2e/reset-db.sh",
    "legacy:export": "tsx --env-file-if-exists=.env scripts/export-supabase.ts",
    "legacy:compare": "tsx scripts/compare-dumps.ts",
    "demo:remove": "tsx --env-file-if-exists=.env scripts/remove-demo-accounts.ts",
    "legacy:preflight": "tsx --env-file-if-exists=.env scripts/preflight-cutover.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@hono/node-server": "^2.1.6",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@tanstack/react-query": "^5.107.1",
    "@vercel/functions": "^3.11.1",
    "bcryptjs": "^3.0.3",
    "better-auth": "1.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.17",
    "lucide-react": "^1.71.0",
    "motion": "^14.12.0",
    "nodemailer": "^7.0.13",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/smtp-server": "^3.5.13",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "smtp-server": "^3.21.4",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.3.8"
  }
}
